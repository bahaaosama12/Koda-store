<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation #{{orderId}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #f4f7fc;
        }
        .email-container {
            max-width: 620px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border: 1px solid #e9edf4;
        }

        .email-header {
            padding: 32px 30px 24px;
            text-align: center;
            background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%);
            border-bottom: 2px solid #d1fae5;
        }
        .email-header .logo {
            font-size: 26px;
            font-weight: 800;
            color: #1a2634;
            letter-spacing: -0.5px;
        }
        .email-header .logo span {
            color: #10b981;
        }
        .email-header .badge {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 20px;
            font-size: 12px;
            font-weight: 700;
            background: #d1fae5;
            color: #065f46;
            border-radius: 50px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .email-body {
            padding: 32px 30px 20px;
            color: #1e293b;
            line-height: 1.7;
            font-size: 15px;
        }
        .email-body .greeting {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #0f172a;
        }
        .email-body .sub-greeting {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 20px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            margin: 6px 0 16px;
            letter-spacing: 0.5px;
        }
        .status-badge.confirmed {
            background: #dbeafe;
            color: #1d4ed8;
        }
        .status-badge.pending {
            background: #fef3c7;
            color: #92400e;
        }
        .status-badge.shipped {
            background: #d1fae5;
            color: #065f46;
        }
        .status-badge.delivered {
            background: #d1fae5;
            color: #065f46;
        }
        .status-badge.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }
        .status-badge.processing {
            background: #e0e7ff;
            color: #4338ca;
        }

        .order-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 20px 24px;
            margin: 18px 0 22px;
            border-left: 4px solid #10b981;
        }
        .order-card .label {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .order-card .order-number {
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            margin-top: 2px;
        }
        .order-card .order-date {
            font-size: 14px;
            color: #475569;
            margin-top: 4px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0 20px;
            font-size: 14px;
        }
        .items-table thead {
            background: #f1f5f9;
        }
        .items-table thead th {
            padding: 10px 12px;
            text-align: left;
            font-weight: 700;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .items-table tbody td {
            padding: 12px;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
        }
        .items-table .product-image {
            width: 50px;
            height: 50px;
            border-radius: 8px;
            object-fit: cover;
        }
        .items-table .product-name {
            font-weight: 600;
            color: #0f172a;
        }
        .items-table .product-price {
            color: #475569;
        }
        .items-table .product-quantity {
            color: #64748b;
            text-align: center;
        }
        .items-table .product-total {
            font-weight: 700;
            color: #0f172a;
        }

        .summary {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 16px 0 20px;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 14px;
            color: #475569;
        }
        .summary-row .label {
            color: #64748b;
        }
        .summary-row .value {
            font-weight: 600;
            color: #0f172a;
        }
        .summary-row.total {
            border-top: 2px solid #e2e8f0;
            margin-top: 6px;
            padding-top: 12px;
            font-size: 18px;
        }
        .summary-row.total .value {
            color: #10b981;
            font-weight: 800;
        }

        .address-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 16px 0 20px;
        }
        .address-card .label {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }
        .address-card .address-line {
            font-size: 14px;
            color: #1e293b;
            line-height: 1.8;
        }
        .address-card .address-line .name {
            font-weight: 700;
        }
        .address-card .address-line .phone {
            color: #64748b;
        }

        .email-footer {
            padding: 20px 30px 24px;
            text-align: center;
            border-top: 1px solid #eef2f7;
            background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%);
        }
        .email-footer p {
           color: #10b981;
            font-size: 13px;
            margin-bottom: 4px;
        }
        .email-footer .copyright {
            font-size: 12px;
        }

        @media (max-width: 480px) {
            body {
                padding: 10px;
            }
            .email-header {
                padding: 24px 16px;
            }
            .email-body {
                padding: 20px 16px;
            }
            .items-table {
                font-size: 12px;
            }
            .items-table thead th,
            .items-table tbody td {
                padding: 8px 6px;
            }
           
            .summary-row.total {
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <div class="logo">Koda<span>Store</span></div>
            <div class="badge">Order {{status}}</div>
        </div>

        <div class="email-body">
            <div class="greeting">Hello {{customerName}},</div>
            <div class="sub-greeting">Thank you for your order! Here are the details:</div>
            <span class="status-badge {{status}}">{{status}}</span>

            <div class="order-card">
                <div class="label">Order Confirmation</div>
                <div class="order-number">#{{orderId}}</div>
                <div class="order-date">{{orderDate}}</div>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th style="text-align:center;">Qty</th>
                        <th style="text-align:right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each items}}
                    <tr>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span class="product-name">{{this.name}}</span>
                            </div>
                        </td>
                        <td class="product-price">${{this.price}}</td>
                        <td class="product-quantity">{{this.quantity}}</td>
                        <td class="product-total" style="text-align:right;">${{multiply this.price  this.quantity}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

            <div class="summary">
                <div class="summary-row">
                    <span class="label">Subtotal:</span>
                    <span class="value">&nbsp;${{subtotal}}</span>
                </div>
                <div class="summary-row">
                    <span class="label">Shipping Fee:</span>
                    <span class="value">&nbsp;${{shippingFee}}</span>
                </div>
                <div class="summary-row">
                    <span class="label">Tax:</span>
                    <span class="value">&nbsp;${{tax}}</span>
                </div>
                {{#if discount}}
                <div class="summary-row">
                    <span class="label">Discount:</span>
                    <span class="value">&nbsp;-${{discount}}</span>
                </div>
                {{/if}}
                <div class="summary-row total">
                    <span class="label">Total:</span>
                    <span class="value">&nbsp; ${{totalPrice}}</span>
                </div>
            </div>

            <div class="address-card">
                <div class="label">Shipping Address</div>
                <div class="address-line">
                    <span class="name">{{shippingAddress.fullName}}</span><br>
                    {{shippingAddress.address}}<br>
                    {{shippingAddress.city}}, {{shippingAddress.country}} {{shippingAddress.postalCode}}<br>
                    <span class="phone">{{shippingAddress.phone}}</span>
                </div>
            </div>

            <div class="address-card" style="border-left-color: #6366f1;">
                <div class="label">Payment Method</div>
                <div class="address-line">
                    <span style="font-weight:600; text-transform:capitalize;">{{paymentMethod}}</span>
                    <span style="color:#64748b; margin-left:12px;">
                        Status: <span style="font-weight:600; text-transform:capitalize;">{{paymentStatus}}</span>
                    </span>
                </div>
            </div>

        <div class="email-footer">
            <p class="copyright">&copy; {{year}} KodaStore. All rights reserved.</p>
        </div>
    </div>
</body>
</html>