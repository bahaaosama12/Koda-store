<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Status Update #{{orderId}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #f4f7fc;
        }
        .email-container {
            max-width: 580px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border: 1px solid #e9edf4;
        }

        .email-header {
            padding: 32px 30px 24px;
            text-align: center;
            background: linear-gradient(135deg, #eef2ff 0%, #ffffff 100%);
            border-bottom: 2px solid #e0e7ff;
        }
        .email-header .logo {
            font-size: 26px;
            font-weight: 800;
            color: #1a2634;
            letter-spacing: -0.5px;
        }
        .email-header .logo span {
            color: #4f46e5;
        }
        .email-header .badge {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 20px;
            font-size: 12px;
            font-weight: 700;
            background: #e0e7ff;
            color: #4338ca;
            border-radius: 50px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .email-body {
            padding: 32px 30px 20px;
            color: #1e293b;
            line-height: 1.7;
            font-size: 15px;
        }
        .email-body .greeting {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #0f172a;
        }
        .email-body .sub-greeting {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 32px;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 700;
            text-transform: uppercase;
            margin: 10px 0 18px;
            letter-spacing: 0.5px;
        }
        .status-badge.pending {
            background: #fef3c7;
            color: #92400e;
        }
        .status-badge.processing {
            background: #e0e7ff;
            color: #4338ca;
        }
        .status-badge.shipped {
            background: #dbeafe;
            color: #1d4ed8;
        }
        .status-badge.delivered {
            background: #d1fae5;
            color: #065f46;
        }
        .status-badge.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }
        .status-badge.confirmed {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .order-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 20px 24px;
            margin: 18px 0 22px;
            border-left: 4px solid #4f46e5;
        }
        .order-card .label {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .order-card .order-number {
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            margin-top: 2px;
        }
        .order-card .order-date {
            font-size: 14px;
            color: #475569;
            margin-top: 4px;
        }

        .status-update {
            background: #f8fafc;
            border-radius: 12px;
            padding: 20px 24px;
            margin: 16px 0 22px;
            text-align: center;
        }
        .status-update .old-status {
            font-size: 14px;
            color: #94a3b8;
            text-decoration: line-through;
        }
        .status-update .arrow {
            font-size: 24px;
            color: #4f46e5;
            margin: 6px 0;
        }
        .status-update .new-status {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        .admin-note {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 16px 0 20px;
            border-left: 4px solid #f59e0b;
        }
        .admin-note .label {
            font-size: 12px;
            font-weight: 700;
            color: #92400e;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .admin-note .note {
            font-size: 15px;
            color: #78350f;
            margin-top: 4px;
        }

        .items-summary {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 16px 0 20px;
        }
        .items-summary .label {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        .items-summary .item {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 14px;
            color: #475569;
            border-bottom: 1px solid #eef2f7;
        }
        .items-summary .item:last-child {
            border-bottom: none;
        }
        .items-summary .item .name {
            font-weight: 500;
            color: #0f172a;
        }
        .items-summary .item .qty {
            color: #64748b;
        }

        .email-footer {
            padding: 20px 30px 24px;
            text-align: center;
            border-top: 1px solid #eef2f7;
            background: linear-gradient(135deg, #eef2ff 0%, #ffffff 100%);
        }
        .email-footer p {
           color: #4f46e5;
            font-size: 13px;
            margin-bottom: 4px;
        }
        .email-footer .copyright {
            font-size: 12px;
        }

        @media (max-width: 480px) {
            body {
                padding: 10px;
            }
            .email-header {
                padding: 24px 16px;
            }
            .email-body {
                padding: 20px 16px;
            }
            .status-badge {
                font-size: 14px;
                padding: 6px 20px;
            }
            .status-update .new-status {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <div class="logo">Koda<span>Store</span></div>
            <div class="badge">Order Status Update</div>
        </div>

        <div class="email-body">
            <div class="greeting">Hello {{customerName}},</div>
            <div class="sub-greeting">There's been an update to your order <strong>#{{orderId}}</strong>.</div>

            <div style="text-align:center;">
                <span class="status-badge {{status}}">{{status}}</span>
            </div>

            <div class="order-card">
                <div class="label">Order Information</div>
                <div class="order-number">#{{orderId}}</div>
                <div class="order-date"> {{orderDate}}</div>
            </div>

            {{#if adminNote}}
            <div class="admin-note">
                <div class="label">Admin Note</div>
                <div class="note">{{adminNote}}</div>
            </div>
            {{/if}}

            <div class="items-summary">
                <div class="label">Order Items</div>
                {{#each items}}
                <div class="item">
                    <span class="name">{{this.name}}</span>
                    <span class="qty">&nbsp;{{this.quantity}} X ${{this.price}}</span>
                </div>
                {{/each}}
                <div class="item" style="border-top: 2px solid #e2e8f0; margin-top:6px; padding-top:8px; font-weight:700;">
                    <span class="name">Total:</span>
                    <span>&nbsp;${{totalPrice}}</span>
                </div>
            </div>
        </div>

        <div class="email-footer">
            <p class="copyright">&copy; {{year}} KodaStore. All rights reserved.</p>
        </div>
    </div>
</body>
</html>