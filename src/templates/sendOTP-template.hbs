<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            margin: 0;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #f4f7fc;
        }
        .email-container {
            max-width: 580px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border: 1px solid #e9edf4;
        }
        .email-header {
            padding: 32px 30px 24px;
            text-align: center;
            background: linear-gradient(135deg, #f8faff 0%, #ffffff 100%);
            border-bottom: 2px solid #f0f4fa;
        }
        .email-header .logo {
            font-size: 26px;
            font-weight: 800;
            color: #1a2634;
            letter-spacing: -0.5px;
        }
        .email-header .logo span { color: #2563eb; }
        .email-header .badge {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 20px;
            font-size: 12px;
            font-weight: 700;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 50px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .email-body {
            padding: 32px 30px 20px;
            color: #1e293b;
            line-height: 1.7;
            font-size: 15px;
        }
        .email-body .greeting {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #0f172a;
        }
        .email-body .sub-greeting {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 18px;
        }
        .otp-wrapper {
            text-align: center;
            margin: 24px 0 20px;
        }
        .otp-code {
            display: inline-block;
            background: #f1f5f9;
            padding: 16px 40px;
            border-radius: 12px;
            font-size: 36px;
            font-weight: 800;
            color:#0f172a;
            letter-spacing: 8px;
            border:  2px dashed #cbd5e1;
            font-family: 'Courier New', monospace;
        }
        .otp-expiry {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 8px;
        }

        .email-footer {
            padding: 20px 30px 24px;
            text-align: center;
            border-top: 1px solid #eef2f7;
              background: linear-gradient(135deg, #f8faff 0%, #ffffff 100%);
        }
        .email-footer p {
           color: #2563eb; 
            font-size: 13px;
            margin-bottom: 4px;
        }
        .email-footer .copyright {
            font-size: 12px;
        }

        @media (max-width: 480px) {
            body { padding: 10px; }
            .email-header { padding: 24px 16px; }
            .email-body { padding: 20px 16px; }
            .otp-code { font-size: 28px; padding: 12px 24px; letter-spacing: 6px; }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <div class="logo">Koda<span>Store</span></div>
            <div class="badge">Verify Email</div>
        </div>

        <div class="email-body">
            <div class="greeting">Hello {{name}}</div>
            <div class="sub-greeting">Welcome to Koda Store!</div>
            <div class="message">
                <p>Thank you for creating an account with us.</p>
        <p>To complete your registration, please verify your email address using the code below:</p>
            </div>
            <div class="otp-wrapper">
                <div class="otp-code">{{otpCode}}</div>
                <div class="otp-expiry">This code expires in {{otpExpiry}} minutes</div>
            </div>
        </div>

        <div class="email-footer">
            <p class="copyright">&copy; {{year}} KodaStore. All rights reserved.</p>
        </div>
    </div>
</body>
</html>