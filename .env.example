
# Backend server port

PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas)

MONGODB_URL=

# Application environment (development, production, or test)

NODE_ENV=development

# Secret key used to sign and verify JWT authentication tokens

JWT_SECRET=

# How long JWT authentication tokens remain valid

JWT_EXPIRE=7d

# SMTP server hostname used to send emails

EMAIL_HOST=

# SMTP server port used for email communication

EMAIL_PORT=

# Email account username used by the application to send emails

EMAIL_USER=

# Email account password or app-specific password

EMAIL_PASS=

# Cloudinary cloud name used for image storage

CLOUDINARY_CLOUD_NAME=

# Cloudinary API key

CLOUDINARY_API_KEY=

# Cloudinary API secret

CLOUDINARY_API_SECRET=

# URL of the frontend application (used for CORS)

CLIENT_URL=

# Stripe publishable key used by the frontend/payment integration

STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret used to verify webhook requests

STRIPE_WEBHOOK_SECRET=

# Stripe secret key used by the backend to communicate with Stripe

STRIPE_SECRET_KEY=

# Stripe
STRIPE_CURRENCY=egp

